{
  "configurations": [
    {
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32h7x.cfg"
      ],
      "cwd": "${workspaceFolder}",
      "debuggerArgs": [
        "-d",
        "${workspaceRoot}"
      ],
      "executable": "${workspaceRoot}/build/GuitarMultiEffect.elf",
      "interface": "swd",
      "name": "Cortex Debug (Build and Debug) (ST-Link Program)",
      "openOCDLaunchCommands": [
        "init",
        "reset init",
        "gdb_breakpoint_override hard"
      ],
      "preLaunchTask": "build and debug (ST-Link) (Flash)",
      "preRestartCommands": [
        "load",
        "enable breakpoint",
        "monitor reset"
      ],
      "request": "launch",
      "runToEntryPoint": "main",
      "servertype": "openocd",
      "showDevDebugOutput": "both",
      "svdFile": "${workspaceRoot}/.vscode/STM32H750x.svd",
      "type": "cortex-debug"
    },
